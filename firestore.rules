rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /drivingUsers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['updatedAt','schemaVersion','ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid;
      match /examSessions/{sessionId} {
        allow read, create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id','date','score','max','wrong','answered','kind','answers','deviceId','createdAt'])
          && request.resource.data.id == sessionId
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 50;
        allow update, delete: if false;
      }
      match /legacyImports/{importId} {
        allow read, create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id','records','history','attemptedIds','oldWrongIds','importedAt'])
          && request.resource.data.id == importId;
        allow update, delete: if false;
      }
    }
  }
}
